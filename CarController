/**
 * CarController – tunn controller enligt MVC:
 * - WorldModel innehåller rörelse, krockar, workshop, snapshot.
 * - SimulationLoop sköter timer.
 * - DrawPanel bygger sin snapshot (View-ansvar).
 * - CarFeatureService sköter Saab-turbo och Scania-flak.
 * Controller hanterar endast UI-kommandon (gas, brake, add/remove) och förmedlar till Model.
 */
public class CarController implements ICarController {
    private static final int MAX_CARS = 10;

    private final WorldModel model;
    private final CarView frame;
    private final SimulationLoop loop;
    private final CarFeatureService featureService = new CarFeatureService();

    public static void main(String[] args) {
        new CarController();
    }

    public CarController() {
        // Workshop för ENDAST Volvo
        var workshop = new Workshop<Volvo240>(3);
        int workshopX = 300, workshopY = 300; double workshopRadius = 80.0;

        // WorldModel:
        this.model = new WorldModel(800, 100, workshop, workshopX, workshopY, workshopRadius);

        // Startbilar
        model.addCar(CarFactory.createVolvo(0, 300));
        model.addCar(CarFactory.createSaab (0, 100));
        model.addCar(CarFactory.createScania(0, 200));

        this.frame = new CarView("CarSim 1.0", this);

        // Rita initialt (View bygger snapshot från Model)
        frame.drawPanel.updateFromCars(model.cars());

        // Timer loop – kör update() + repaint() via WorldModel + View
        this.loop = new SimulationLoop(50, this::tick);
        loop.start();
    }

    private void tick() {
        model.update();
        frame.drawPanel.updateFromCars(model.cars());
    }

    //Interface
    @Override public void gas(int amount)   { model.gas(amount / 100.0); }
    @Override public void brake(int amount) { model.brake(amount / 100.0); }
    @Override public void startAllCars()    { model.startAll(); }
    @Override public void stopAllCars()     { model.stopAll(); }

    @Override public void turboOn()  { featureService.turboOn(model.cars()); }
    @Override public void turboOff() { featureService.turboOff(model.cars()); }
    @Override public void liftBed()  { featureService.liftBed(model.cars()); }
    @Override public void lowerBed() { featureService.lowerBed(model.cars()); }

    // Uppgift 5: Add / Remove
    @Override
    public void addCarRandom() {
        if (model.size() >= MAX_CARS) return;

        // Placering: x=0, y i 100-steg. Om panelen inte init: default 600 px.
        int panelH = (frame != null) ? frame.drawPanel.getHeight() : 600;
        int slots = Math.max(1, panelH / 100);
        int idx   = model.size();
        int y     = Math.max(100, (idx % slots) * 100);
        int x     = 0;

        model.addCar(CarFactory.createRandom(x, y));

        // Rita direkt
        frame.drawPanel.updateFromCars(model.cars());
    }

    @Override
    public void removeCar() {
        if (model.size() == 0) return;
        model.removeCar();
        frame.drawPanel.updateFromCars(model.cars());
    }
}
